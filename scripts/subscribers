#!/usr/bin/env bash
set -euo pipefail

if [[ -z "${STW_SSH:-}" ]]; then
  echo "Set STW_SSH to the server, for example: STW_SSH=root@203.0.113.7 scripts/subscribers" >&2
  exit 1
fi

ssh_args=()
if [[ -n "${STW_SSH_KEY:-}" ]]; then ssh_args+=(-i "$STW_SSH_KEY"); fi

ssh "${ssh_args[@]}" "$STW_SSH" "cd ${STW_DIR:-/opt/stw} && docker compose exec -T stw node -" <<'JS'
const { DatabaseSync } = require('node:sqlite')
const db = new DatabaseSync(process.env.STW_DB, { readOnly: true })

console.log('== EMAIL SUBSCRIBERS ==')
console.table(db.prepare(`
  SELECT site_id, email, status, created_at, confirmed_at
  FROM subscribers
  ORDER BY site_id, status, created_at
`).all())

console.log('== FEDIVERSE FOLLOWERS ==')
console.table(db.prepare(`
  SELECT site_id, actor_id, created_at
  FROM followers
  ORDER BY site_id, created_at
`).all())
JS
