                        }
                      ],
                      "next_cursor": "eyJ2IjoxLCJvIjoiZGVzYyIsInMiOjQxLCJhIjpudWxsLCJiIjpudWxsfQ"
                    }
                  },
                  "caughtUp": {
                    "summary": "Oldest first, nothing new yet; keep the cursor",
                    "value": {
                      "items": [],
                      "next_cursor": "eyJ2IjoxLCJvIjoiYXNjIiwicyI6NDIsImEiOm51bGwsImIiOm51bGx9"
