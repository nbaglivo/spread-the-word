{
  "openapi": "3.1.0",
  "info": {
    "title": "warmhole reader API",
    "version": "1.0.0",
    "summary": "Read what the accounts a site follows have posted, and manage who the site follows.",
    "description": "A small, private API for one reader (for example Coffee Companion) per site. Every request is scoped to one site and authenticated with that site's reader token. Responses are JSON. Timestamps are RFC 3339 in UTC with millisecond precision, for example 2026-10-16T06:12:03.000Z. Within /reader/v1, fields and enum values may be added; clients must ignore unknown fields and treat unknown enum values like the closest generic value (an unknown item type like Note, an unknown attachment kind like other). Removing or renaming a field, or changing its meaning, requires /reader/v2. Design: docs/superpowers/specs/2026-10-16-reader-api-design.md.",
    "license": {
      "name": "MIT",
      "identifier": "MIT"
    }
  },
  "servers": [
    {
      "url": "https://ap.nbaglivo.dev/reader/v1",
      "description": "The Inner Monologue's warmhole instance"
    },
    {
      "url": "http://localhost:8080/reader/v1",
      "description": "Local development"
    }
  ],
  "security": [
    {
      "readerToken": []
    }
  ],
  "tags": [
    {
      "name": "items",
      "description": "Posts received from accounts the site follows, including boosts."
    },
    {
      "name": "following",
      "description": "Accounts the site follows, and following or unfollowing them."
    }
  ],
  "paths": {
    "/sites/{siteId}/items": {
      "get": {
        "tags": ["items"],
        "operationId": "listItems",
        "summary": "List received items",
        "description": "Items are listed in arrival order: the order warmhole stored them in, which is also the order of received_at. Paging is keyset-based on an internal, ever-increasing sequence number, so it is stable under inserts: a page never repeats or skips an item because new items arrived. In desc order new items only ever appear before the first page; in asc order they appear after the last page. Deleted items are never listed. since and until filter on received_at as a half-open window: received_at > since and received_at <= until. Pass next_cursor as cursor to get the next page. A cursor carries order, since and until; repeating them with the same values is allowed, different values are rejected with invalid_cursor. next_cursor is null only when no further item can ever match: in desc order once the oldest match was returned, in asc order once the newest match was returned and until is set. In asc order without until, next_cursor is always present, so a client can keep it and resume from it later to get only what arrived since; an empty items array then means it is caught up.",
        "parameters": [
          { "$ref": "#/components/parameters/SiteId" },
          { "$ref": "#/components/parameters/Since" },
          { "$ref": "#/components/parameters/Until" },
          { "$ref": "#/components/parameters/Order" },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/Cursor" }
        ],
        "responses": {
          "200": {
            "description": "A page of items.",
            "headers": {
              "Cache-Control": { "$ref": "#/components/headers/NoStore" }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/ItemPage" },
                "examples": {
                  "morning": {
                    "summary": "Newest first, two items, more to come",
                    "value": {
                      "items": [
                        {
                          "id": "https://mastodon.social/users/alice/statuses/113284750912345678",
                          "url": "https://mastodon.social/@alice/113284750912345678",
                          "type": "Note",
                          "visibility": "public",
                          "published": "2026-10-16T06:12:03.000Z",
                          "updated": null,
                          "title": null,
                          "summary": null,
                          "sensitive": false,
                          "content_html": "<p>First pour-over of the season. The <a href=\"https://mastodon.social/tags/coffee\" class=\"mention hashtag\" rel=\"nofollow noopener noreferrer\">#<span>coffee</span></a> tastes like October.</p>",
                          "content_text": "First pour-over of the season. The #coffee tastes like October.",
                          "language": "en",
                          "author": {
                            "id": "https://mastodon.social/users/alice",
                            "handle": "@alice@mastodon.social",
                            "name": "Alice",
                            "avatar_url": "https://files.mastodon.social/accounts/avatars/000/000/001/original/alice.png",
                            "profile_url": "https://mastodon.social/@alice"
                          },
                          "boost": null,
                          "in_reply_to": null,
                          "attachments": [
                            {
                              "url": "https://files.mastodon.social/media_attachments/files/113/284/750/original/kettle.jpg",
                              "media_type": "image/jpeg",
                              "kind": "image",
                              "description": "A gooseneck kettle pouring water over a paper filter.",
                              "width": 1600,
                              "height": 1200
                            }
                          ],
                          "hashtags": [
                            { "name": "coffee", "url": "https://mastodon.social/tags/coffee" }
                          ],
                          "mentions": [],
                          "received_at": "2026-10-16T06:12:05.412Z"
                        },
                        {
                          "id": "https://write.as/bob/autumn-reading",
                          "url": "https://write.as/bob/autumn-reading",
                          "type": "Article",
                          "visibility": "public",
                          "published": "2026-10-15T21:00:00.000Z",
                          "updated": "2026-10-15T21:40:00.000Z",
                          "title": "Autumn reading",
                          "summary": "Five books for long evenings.",
                          "sensitive": false,
                          "content_html": "<h2>One</h2><p>A slow book about rivers.</p>",
                          "content_text": "One\n\nA slow book about rivers.",
                          "language": null,
                          "author": {
                            "id": "https://write.as/api/collections/bob",
                            "handle": "@bob@write.as",
                            "name": "Bob's notebook",
                            "avatar_url": null,
                            "profile_url": "https://write.as/bob/"
                          },
                          "boost": {
                            "by": {
                              "id": "https://hachyderm.io/users/carol",
                              "handle": "@carol@hachyderm.io",
                              "name": "Carol",
                              "avatar_url": "https://media.hachyderm.io/accounts/avatars/carol.png",
                              "profile_url": "https://hachyderm.io/@carol"
